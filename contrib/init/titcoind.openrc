#!/sbin/openrc-run

# backward compatibility for existing gentoo layout 
#
if [ -d "/var/lib/kriptoyng/.kriptoyng" ]; then
	kriptoyngD_DEFAULT_DATADIR="/var/lib/kriptoyng/.kriptoyng"
else
	kriptoyngD_DEFAULT_DATADIR="/var/lib/kriptoyngd"
fi

kriptoyngD_CONFIGFILE=${kriptoyngD_CONFIGFILE:-/etc/kriptoyng/kriptoyng.conf}
kriptoyngD_PIDDIR=${kriptoyngD_PIDDIR:-/var/run/kriptoyngd}
kriptoyngD_PIDFILE=${kriptoyngD_PIDFILE:-${kriptoyngD_PIDDIR}/kriptoyngd.pid}
kriptoyngD_DATADIR=${kriptoyngD_DATADIR:-${kriptoyngD_DEFAULT_DATADIR}}
kriptoyngD_USER=${kriptoyngD_USER:-${kriptoyng_USER:-kriptoyng}}
kriptoyngD_GROUP=${kriptoyngD_GROUP:-kriptoyng}
kriptoyngD_BIN=${kriptoyngD_BIN:-/usr/bin/kriptoyngd}
kriptoyngD_NICE=${kriptoyngD_NICE:-${NICELEVEL:-0}}
kriptoyngD_OPTS="${kriptoyngD_OPTS:-${kriptoyng_OPTS}}"

name="kriptoyng Daemon"
description="kriptoyng cryptocurrency P2P network daemon"

command="/usr/bin/kriptoyngd"
command_args="-pid=\"${kriptoyngD_PIDFILE}\" \
		-conf=\"${kriptoyngD_CONFIGFILE}\" \
		-datadir=\"${kriptoyngD_DATADIR}\" \
		-daemon \
		${kriptoyngD_OPTS}"

required_files="${kriptoyngD_CONFIGFILE}"
start_stop_daemon_args="-u ${kriptoyngD_USER} \
			-N ${kriptoyngD_NICE} -w 2000"
pidfile="${kriptoyngD_PIDFILE}"

# The retry schedule to use when stopping the daemon. Could be either
# a timeout in seconds or multiple signal/timeout pairs (like
# "SIGKILL/180 SIGTERM/300")
retry="${kriptoyngD_SIGTERM_TIMEOUT}"

depend() {
	need localmount net
}

# verify
# 1) that the datadir exists and is writable (or create it)
# 2) that a directory for the pid exists and is writable
# 3) ownership and permissions on the config file
start_pre() {
	checkpath \
	-d \
	--mode 0750 \
	--owner "${kriptoyngD_USER}:${kriptoyngD_GROUP}" \
	"${kriptoyngD_DATADIR}"

	checkpath \
	-d \
	--mode 0755 \
	--owner "${kriptoyngD_USER}:${kriptoyngD_GROUP}" \
	"${kriptoyngD_PIDDIR}"

	checkpath -f \
	-o ${kriptoyngD_USER}:${kriptoyngD_GROUP} \
	-m 0660 \
	${kriptoyngD_CONFIGFILE}

	checkconfig || return 1
}

checkconfig()
{
	if ! grep -qs '^rpcpassword=' "${kriptoyngD_CONFIGFILE}" ; then
		eerror ""
		eerror "ERROR: You must set a secure rpcpassword to run kriptoyngd."
		eerror "The setting must appear in ${kriptoyngD_CONFIGFILE}"
		eerror ""
		eerror "This password is security critical to securing wallets "
		eerror "and must not be the same as the rpcuser setting."
		eerror "You can generate a suitable random password using the following "
		eerror "command from the shell:"
		eerror ""
		eerror "bash -c 'tr -dc a-zA-Z0-9 < /dev/urandom | head -c32 && echo'"
		eerror ""
		eerror "It is recommended that you also set alertnotify so you are "
		eerror "notified of problems:"
		eerror ""
		eerror "ie: alertnotify=echo %%s | mail -s \"kriptoyng Alert\"" \
			"admin@foo.com"
		eerror ""
		return 1
	fi
}
