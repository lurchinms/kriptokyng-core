# /etc/conf.d/kriptoyngd: config file for /etc/init.d/kriptoyngd

# Config file location
#kriptoyngD_CONFIGFILE="/etc/kriptoyng/kriptoyng.conf"

# What directory to write pidfile to?  (created and owned by $kriptoyngD_USER)
#kriptoyngD_PIDDIR="/var/run/kriptoyngd"

# What filename to give the pidfile
#kriptoyngD_PIDFILE="${kriptoyngD_PIDDIR}/kriptoyngd.pid"

# Where to write kriptoyngd data (be mindful that the blockchain is large)
#kriptoyngD_DATADIR="/var/lib/kriptoyngd"

# User and group to own kriptoyngd process
#kriptoyngD_USER="kriptoyng"
#kriptoyngD_GROUP="kriptoyng"

# Path to kriptoyngd executable
#kriptoyngD_BIN="/usr/bin/kriptoyngd"

# Nice value to run kriptoyngd under
#kriptoyngD_NICE=0

# Additional options (avoid -conf and -datadir, use flags above)
#kriptoyngD_OPTS=""

# The timeout in seconds OpenRC will wait for kriptoyngd to terminate
# after a SIGTERM has been raised.
# Note that this will be mapped as argument to start-stop-daemon's
# '--retry' option, which means you can specify a retry schedule
# here. For more information see man 8 start-stop-daemon.
kriptoyngD_SIGTERM_TIMEOUT=60
